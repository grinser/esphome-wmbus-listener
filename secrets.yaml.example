# Copy this file to `secrets.yaml` and fill in the real values.
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml is gitignored — never commit real credentials.

# --- Wi-Fi -------------------------------------------------------------------
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# --- ESPHome native API ------------------------------------------------------
# 32-byte base64 key. Generate one with:
#   python3 -c 'import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())'
# (or click "generate" in the ESPHome dashboard). Paste the same key into Home Assistant.
api_key: "REPLACE_WITH_GENERATED_BASE64_KEY="

# --- Meter (from your grid operator) -----------------------------------------
# wM-Bus radio (link-layer) address your meter transmits under — 8 hex digits
# (upper or lower case). Keep 0A1B2C3D if you do not know it yet. Important: this is
# not the serial printed on the meter label (e.g. 12345678) — that fabrication
# serial lives only inside the *encrypted* payload. docs/setup.md, step 3,
# shows how to find the radio address.
meter_address: "0A1B2C3D"
# AES-128 key: the personal access code ("Zugangscode") you get after activating the
# customer interface — 32 hex characters. This one is genuinely secret.
meter_key: "000102030405060708090A0B0C0D0E0F"
